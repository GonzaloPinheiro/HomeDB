{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "",
  "ConnectionStrings": {
    "PostgreSQL_HomeDB": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": ""
  },
  "Storage": {
    "AvailabilityCheckIntervalSeconds": 60,
    "Disks": [
      {
        "Key": "m2-1",
        "Path": "/storage",
        "StartupPolicy": "Required",
        "MinFreeBytes": 0,
        "Locations": [
          { "Key": "main", "Usage": "Personal", "IsDefault": true, "SubPath": "files", "IncludeInBackup": true, "MaxUsedBytes": null },
          { "Key": "temp", "Usage": "Temp", "IsDefault": true, "SubPath": "temp-uploads", "IncludeInBackup": false, "MaxUsedBytes": null }
        ]
      },
      {
        "Key": "hdd1",
        "Path": "/das/hdd1",
        "StartupPolicy": "Optional",
        "MinFreeBytes": 0,
        "Locations": [
          { "Key": "media", "Usage": "Media", "IsDefault": true, "SubPath": "media", "IncludeInBackup": false, "MaxUsedBytes": null }
        ]
      },
      {
        "Key": "hdd2",
        "Path": "/das/hdd2",
        "StartupPolicy": "Optional",
        "MinFreeBytes": 0,
        "Locations": [
          { "Key": "backups", "Usage": "Backups", "IsDefault": true, "SubPath": "backups", "IncludeInBackup": false, "MaxUsedBytes": null }
        ]
      }
    ],

    "MaxFileSizeBytes": 524288000, //500 MB
    "StorageLimitBytes": 10737418240 //10 GB
  },
  "UploadCleanupOptions": {
    "RunAtHourUtc": 3
  },
  "Auth": {
    "CookieSameSite": "None"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "SystemMetrics": {
    "SampleIntervalMinutes": 1,
    "RetentionDays": 30
  },
  "LogFallback": {
    "BasePath": "/logs/failed-logs"
  },
  "Backup": {
    "CheckIntervalMinutes": 60,
    "Daily": {
      "RunAtHourUtc": 3,
      "IntervalHours": 24
    }
  },
  "RateLimiting": {
    "Global": {
      "Enabled": true,
      "TokenLimit": 500,
      "TokensPerPeriod": 500,
      "ReplenishmentPeriod": "00:01:00" //Es un TimeSpan (1min)
    },
    "Auth": {
      "Enabled": true,
      "TokenLimit": 10,
      "TokensPerPeriod": 10,
      "ReplenishmentPeriod": "00:01:00" //Es un TimeSpan (1min)
    }
  }
}