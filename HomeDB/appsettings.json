{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "",
  "ConnectionStrings": {
    "PostgreSQL_HomeDB": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": ""
  },
  "Storage": {
    "BasePath": "/storage/files",
    "TempUploadsPath": "/storage/temp-uploads",
    "MaxFileSizeBytes": 524288000, //500 MB
    "StorageLimitBytes": 10737418240 //10 GB
  },
  "UploadCleanupOptions": {
    "RunAtHourUtc": 3
  },
  "Auth": {
    "CookieSameSite": "None"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "SystemMetrics": {
    "SampleIntervalMinutes": 1,
    "RetentionDays": 30
  },
  "LogFallback": {
    "BasePath": "/storage/logs/failed-logs"
  },
  "RateLimiting": {
    "Global": {
      "Enabled": true,
      "TokenLimit": 100,
      "TokensPerPeriod": 100,
      "ReplenishmentPeriod": "00:01:00" //Es un TimeSpan (1min)
    },
    "Auth": {
      "Enabled": true,
      "TokenLimit": 10,
      "TokensPerPeriod": 10,
      "ReplenishmentPeriod": "00:01:00" //Es un TimeSpan (1min)
    }
  }
}